# ── backend-Node environment variables ──────────────────────────────
# Copy to .env and fill in. Loaded via dotenv in index.js (dotenv.config()).

PORT=3000
NODE_ENV=development

# MongoDB connection string (Atlas → Database → Connect → Drivers).
# Make sure your current IP is whitelisted in Atlas → Network Access.
MONGO_URI=

# JWT signing secret for cookie-based auth (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
JWT_SECRET=

# Credentials used by scripts/seedUser.js (never commit real values)
SEED_USER_NAME=Admin
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=change_me_before_seeding
SEED_USER_TYPE=student

# Frontend origin allowed by CORS (localhost:5173 is always allowed)
FRONTEND_URL=http://localhost:5173

# ── AI / external APIs ──────────────────────────────────────────────

# Google Gemini API key. When missing, /analyze-resume falls back to the
# built-in offline analysis engine; /interview/* fall back to canned
# questions / placeholder reports.
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# RapidAPI key for the jsearch job listings API (GET /job-recommendations).
# Get one at: https://rapidapi.com (subscribe to "Jsearch")
RAPIDAPI_KEY=

# ── Optional ────────────────────────────────────────────────────────

# Where tesseract.js caches its ~5 MB English traineddata file
# (default: <OS tmpdir>/hirepulse-tessdata). Set this if the OS temp
# dir is not writable in your deployment (e.g. some serverless hosts).
TESSDATA_CACHE_PATH=
